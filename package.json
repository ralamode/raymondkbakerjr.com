{
  "name": "raymondkbakerjr-com",
  "version": "0.0.0",
  "private": true,
  "description": "Source for raymondkbakerjr.com, a static engineering portfolio.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node scripts/check-doc-links.mjs",
    "audit:deps": "pnpm audit --prod --audit-level=critical",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:links && pnpm build && pnpm audit:dist && pnpm e2e && pnpm audit:deps",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:publish": "node scripts/publish-screenshots.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
