---
/**
 * The homepage: a name and the links off it. No tagline, bio or footer, by product decision.
 * "Software Engineer" lives in the title and meta description rather than on the page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ray Baker | Software Engineer"
  description="Personal website of Ray Baker, software engineer. Find me on GitHub and LinkedIn."
  path="/"
>
  <h1>Ray Baker</h1>
  <nav aria-label="Primary">
    <ul>
      <li>
        <a href="https://github.com/ralamode">GitHub</a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/raymondbaker">LinkedIn</a>
      </li>
      <li>
        <a href="/about">About</a>
      </li>
    </ul>
  </nav>
</BaseLayout>

<style>
  /*
   * 28px of optical space between the name and the links. The anchors carry visually empty
   * padding to reach a 44px touch target, so it is subtracted here rather than stacking on top:
   * otherwise the measured gap and the perceived gap disagree.
   */
  nav {
    margin-top: calc(28px - var(--link-pad-block));
  }
</style>
